rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFriendInChat(data) {
      return (
        request.auth.uid == data.userA
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/amigos/$(data.userB))
      ) || (
        request.auth.uid == data.userB
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/amigos/$(data.userA))
      );
    }

    function hasChatUsers(data) {
      return data.keys().hasAll(['userA', 'userB']);
    }

    function hasValidChatUsers(data) {
      return hasChatUsers(data)
        && data.userA in data.participantes
        && data.userB in data.participantes
        && data.userA != data.userB;
    }

    function canReadChat(data) {
      return signedIn()
        && request.auth.uid in data.participantes
        && (
          isFriendInChat(data)
          || !hasChatUsers(data)
        );
    }

    function hasEventAccess(data) {
      return signedIn()
        && data.keys().hasAll(['criadoPor', 'participantes', 'convidadoUids', 'convidados'])
        && (
          request.auth.uid == data.criadoPor
          || request.auth.uid in data.participantes
          || request.auth.uid in data.convidadoUids
          || (
            request.auth.token.email != null
            && request.auth.token.email in data.convidados
          )
        );
    }

    function eventOwnerUnchanged() {
      return request.resource.data.criadoPor == resource.data.criadoPor;
    }

    function onlyAttendanceChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['participantes', 'respostas', 'atualizadoEm']);
    }

    function onlyOwnResponseChanged() {
      return request.resource.data.respostas.diff(resource.data.respostas).affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    function selfAttendanceChanged() {
      return onlyAttendanceChanged()
        && onlyOwnResponseChanged()
        && (
          (
            !(request.auth.uid in resource.data.participantes)
            && request.auth.uid in request.resource.data.participantes
            && request.resource.data.participantes.hasAll(resource.data.participantes)
            && request.resource.data.participantes.size() == resource.data.participantes.size() + 1
          )
          || (
            request.auth.uid in resource.data.participantes
            && !(request.auth.uid in request.resource.data.participantes)
            && resource.data.participantes.hasAll(request.resource.data.participantes)
            && request.resource.data.participantes.size() == resource.data.participantes.size() - 1
          )
          || (
            (
              (
                request.auth.uid in resource.data.participantes
                && request.auth.uid in request.resource.data.participantes
              )
              || (
                !(request.auth.uid in resource.data.participantes)
                && !(request.auth.uid in request.resource.data.participantes)
              )
            )
            && request.resource.data.participantes == resource.data.participantes
          )
        );
    }

    function onlySelfHiddenChanged() {
      let oldHidden = resource.data.get('ocultoPara', []);
      let newHidden = request.resource.data.get('ocultoPara', []);

      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['ocultoPara', 'participantes', 'respostas', 'atualizadoEm'])
        && onlyOwnResponseChanged()
        && request.resource.data.respostas[request.auth.uid] == 'removido'
        && request.auth.uid in newHidden
        && newHidden.hasAll(oldHidden)
        && (
          request.auth.uid in oldHidden
          || newHidden.size() == oldHidden.size() + 1
        )
        && (
          request.resource.data.participantes == resource.data.participantes
          || (
            request.auth.uid in resource.data.participantes
            && !(request.auth.uid in request.resource.data.participantes)
            && resource.data.participantes.hasAll(request.resource.data.participantes)
            && request.resource.data.participantes.size() == resource.data.participantes.size() - 1
          )
        );
    }

    function onlyCommentsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['comentarios', 'atualizadoEm']);
    }

    match /usuarios/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);

      match /favoritos/{favoritoId} {
        allow read, write: if isOwner(userId);
      }

      match /amigos/{amigoId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId)
          || (signedIn() && request.auth.uid == amigoId);
      }

      match /notificacoes/{notificacaoId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['tipo', 'titulo', 'mensagem', 'lida', 'criadoEm'])
          && request.resource.data.lida == false
          && request.resource.data.tipo in [
            'evento',
            'comentario',
            'mensagem_evento',
            'evento_cancelado',
            'amizade',
            'amizade_aceita',
            'chat',
            'post',
            'comentario_post'
          ];
      }
    }

    match /amizades/{amizadeId} {
      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
        );
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.keys().hasAll([
          'fromUid',
          'fromNome',
          'fromEmail',
          'fromFoto',
          'toUid',
          'toNome',
          'toEmail',
          'toFoto',
          'status',
          'criadoEm',
          'atualizadoEm'
        ]);
      allow update: if signedIn()
        && resource.data.status == 'pendente'
        && request.auth.uid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'atualizadoEm'])
        && request.resource.data.status in ['aceito', 'recusado'];
      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
        );
    }

    match /eventos_sociais/{eventoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.keys().hasAll([
          'titulo',
          'local',
          'data',
          'participantes',
          'convidadoUids',
          'convidados',
          'respostas',
          'status',
          'criadoEm',
          'atualizadoEm'
        ])
        && request.auth.uid in request.resource.data.participantes;
      allow update: if signedIn()
        && eventOwnerUnchanged()
        && (
          resource.data.criadoPor == request.auth.uid
          || selfAttendanceChanged()
          || onlySelfHiddenChanged()
          || onlyCommentsChanged()
        );
      allow delete: if signedIn() && resource.data.criadoPor == request.auth.uid;

      match /mensagens/{mensagemId} {
        allow read: if hasEventAccess(
          get(/databases/$(database)/documents/eventos_sociais/$(eventoId)).data
        );
        allow create: if hasEventAccess(
            get(/databases/$(database)/documents/eventos_sociais/$(eventoId)).data
          )
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasAll(['uid', 'nome', 'texto', 'criadoEm'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 1000;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'uid',
          'nome',
          'fotoUsuario',
          'restaurante',
          'legenda',
          'imagemUrl',
          'criadoEm'
        ]);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['restaurante', 'legenda', 'atualizadoEm']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /comentarios/{comentarioId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasAll(['uid', 'nome', 'fotoUsuario', 'texto', 'criadoEm'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 1000;
        allow update, delete: if signedIn()
          && (
            resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid
          );
      }
    }

    match /reservas/{reservaId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if canReadChat(resource.data);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantes
        && request.resource.data.participantes.size() == 2
        && hasValidChatUsers(request.resource.data)
        && isFriendInChat(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantes
        && request.resource.data.participantes == resource.data.participantes
        && hasValidChatUsers(request.resource.data)
        && isFriendInChat(request.resource.data)
        && (
          !hasChatUsers(resource.data)
          || (
            request.resource.data.userA == resource.data.userA
            && request.resource.data.userB == resource.data.userB
          )
        );
      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read: if canReadChat(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        );
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes
          && isFriendInChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasAll(['uid', 'nome', 'texto', 'criadoEm'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 1000;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
